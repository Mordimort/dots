      <command>loffice -calc</command>
    </action>
  </item>
  <item label="LibreOffice Draw">
    <action name="Execute">
      <command>loffice -draw</command>
    </action>
  </item>
  <item label="LibreOffice Impress">
    <action name="Execute">
      <command>loffice -impress</command>
    </action>
  </item>
  <item label="LibreOffice Math">
    <action name="Execute">
      <command>loffice -math</command>
    </action>
  </item>
  <item label="LibreOffice Writer">
    <action name="Execute">
      <command>loffice -writer</command>
    </action>
  </item>
</menu>

<menu id="apps-multimedia-menu" label="Multimedia">
  <item label="Haruna">
    <action name="Execute">
      <command>haruna</command>
      <startupnotify>
        <enabled>yes</enabled>
      </startupnotify>
    </action>
</item>
<item label="OBS Studio">
    <action name="Execute">
