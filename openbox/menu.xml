      </startupnotify>
    </action>
  </item> 
</menu>

<menu id="apps-fileman-menu" label="File Managers">
    <item label="Thunar">
    <action name="Execute">
      <command>Thunar</command>
      <startupnotify>
        <enabled>yes</enabled>
      </startupnotify>
    </action>
  </item>
  <item label="Dolphin">
    <action name="Execute">
      <command>dolphin</command>
      <startupnotify>
