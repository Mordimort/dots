      </startupnotify>
    </action>
  </item>
  </menu>

<menu id="apps-graphics-menu" label="Graphics">
    <item label="Gwenview">
    <action name="Execute">
      <command>gwenview</command>
      <startupnotify>
        <enabled>yes</enabled>
      </startupnotify>
    </action>
  </item>
    <item label="Krita">
    <action name="Execute">
      <command>krita</command>
      <startupnotify>
